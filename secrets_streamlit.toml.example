# Cole em Settings > Secrets do app no Streamlit Cloud.
# O bloco [cookie] e [credentials...] sai de `python gerar_usuario.py --secrets`.

BRAPI_API_KEY = "sua-chave"

[cookie]
key = "chave-aleatoria-longa"
expiry_days = 7

[credentials.usernames.jose]
name = "José"
email = "jose@exemplo.com"
password = "$2b$12$hash-bcrypt-gerado-pelo-gerar_usuario.py"
